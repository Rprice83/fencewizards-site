{
  "name": "fencewizards-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "check": "node build/check.mjs",
    "dev": "node build/build.mjs && wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply fencewizards-quotes --local",
    "db:migrate:remote": "wrangler d1 migrations apply fencewizards-quotes --remote",
    "test": "node --test",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.147.0",
    "yaml": "^2.9.1"
  }
}
